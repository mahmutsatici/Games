# Same line endings on every machine: text files are stored and checked out with LF
# (stops the "LF will be replaced by CRLF" warnings on Windows).
* text=auto eol=lf

# Binary files: never touch them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary

# Windows batch files need CRLF or cmd misreads labels
*.bat text eol=crlf
*.cmd text eol=crlf
